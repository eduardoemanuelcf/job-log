#!/bin/sh
old=$(git show origin/main:manifest.json 2>/dev/null | grep -o '"version"[^,]*' | cut -d'"' -f4)
new=$(grep -o '"version"[^,]*' manifest.json | cut -d'"' -f4)
[ -z "$old" ] && exit 0

if [ "$old" = "$new" ] &&
   git diff --name-only origin/main..HEAD | grep -qvE '^(README|PRIVACY|TERMS|CLAUDE)\.md$|^docs/|^hooks/'; then
    echo "❌ Cambió código pero manifest.json sigue en $new."
    echo "   Bumpeá \"version\" (o 'git push --no-verify' si de verdad no hace falta)."
    exit 1
fi
